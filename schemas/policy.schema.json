{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "severity", "events", "instruction", "when", "parameters"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "severity": {"const": "mandatory"},
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "before_completion"}
    },
    "instruction": {"type": "string", "minLength": 1},
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fact", "operator", "value"],
            "properties": {
              "fact": {"type": "string", "minLength": 1},
              "operator": {"enum": ["equals", "greater_than_or_equal"]},
              "value": {}
            }
          }
        }
      }
    },
    "parameters": {"type": "object"}
  }
}
